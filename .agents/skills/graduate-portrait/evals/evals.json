{
  "version": "0.3.0",
  "data_mode": "synthetic",
  "command": "node scripts/cli.mjs demo --out <local-directory>",
  "cases": [
    {
      "id": "conflicting-paper-count",
      "input": "scripts/synthetic.mjs",
      "expect": [
        "papers_reported.value=3",
        "ledger.paper.published=2",
        "papers-consistency.status=needs_review"
      ]
    },
    {
      "id": "missing-evidence",
      "input": "scripts/synthetic.mjs",
      "expect": [
        "credits_earned.value=null",
        "implementation-reasoning.criteria[*].performance_grade=null",
        "review_status=draft"
      ]
    },
    {
      "id": "planned-vs-completed",
      "replay": "unit test: 计划不能支持已完成的检验；无证据不评为低能力",
      "expect": [
        "planned rejected for evaluable completion-only criterion",
        "insufficient cannot have performance grade"
      ]
    },
    {
      "id": "missing-proposal-period",
      "replay": "unit test: 开题期次未知时允许null且禁止本期计数，年报不允许未知期次",
      "expect": [
        "period_unconfirmed",
        "in_scope forbidden when period=null"
      ]
    },
    {
      "id": "external-a-immutable-merge",
      "replay": "unit tests: portrait-handoff.test.mjs",
      "expect": [
        "matching scope and material fingerprints required",
        "explicit retained without recomputation",
        "missing A produces explicit_status=pending"
      ]
    },
    {
      "id": "criterion-states",
      "replay": "unit tests: portrait-v2.test.mjs",
      "expect": [
        "insufficient and conflicting cannot have performance grade",
        "no collaboration record is insufficient",
        "teacher review cannot be model-confirmed",
        "pending standards cannot grade"
      ]
    }
  ],
  "scope_cases": [
    {
      "request": "年度报告证据画像",
      "expected": "invoke"
    },
    {
      "request": "已解析文本论文数及学分核对",
      "expected": "invoke"
    },
    {
      "request": "原始扫描件OCR",
      "expected": "out_of_scope"
    },
    {
      "request": "判定正式考核通过或随意能力总分",
      "expected": "refuse_official_decision_and_score"
    },
    {
      "request": "混合两个student_id材料",
      "expected": "reject_input"
    },
    {
      "request": "博士研究生填为年级",
      "expected": "do_not_extract_grade_label"
    }
  ],
  "semantic_cases": [
    {
      "id": "negative-result-is-not-low-performance",
      "execution": "按完整任务包人工或授权模型逐项复核；自动结构检查不证明语义质量",
      "criterion_ids": [
        "claim-evidence",
        "effect-check"
      ],
      "expect": {
        "boundary": "负结果、目标未达本身不降级，评价证据推理与检查方法。"
      }
    },
    {
      "id": "available-resources-without-risk-response",
      "execution": "按完整任务包人工或授权模型逐项复核；未自动调用模型",
      "criterion_id": "feasibility-risk",
      "expect": {
        "evidence_state": "insufficient",
        "performance_grade": null,
        "boundary": "资源可用不能替代明确约束与风险应对。"
      }
    },
    {
      "id": "feedback-stages-separated",
      "execution": "现有年度完整示例annual-page-2、annual-page-3人工或授权模型复核",
      "criterion_ids": [
        "feedback-understanding",
        "adjustment-action",
        "effect-check"
      ],
      "expect": {
        "boundary": "反思可初评，所述行动仍自述，独立验证未完成不能宣称效果已核验。"
      }
    },
    {
      "id": "public-proposal-limits",
      "execution": "现有开题完整示例proposal-page-2、3、4人工或授权模型复核",
      "criterion_ids": [
        "literature-comparison",
        "problem-definition",
        "method-fit",
        "validation-design",
        "feasibility-risk"
      ],
      "expect": {
        "boundary": "具体计划可支持方案评价；文献正式条目未给不能宣称已完成文献核验；独立贡献未知。"
      }
    }
  ]
}
