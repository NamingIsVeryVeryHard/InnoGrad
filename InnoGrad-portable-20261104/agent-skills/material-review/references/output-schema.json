{
  "$defs": {
    "Check": {
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "conclusion": {
          "enum": [
            "compliant",
            "non_compliant",
            "unable_to_determine",
            "not_applicable"
          ],
          "title": "Conclusion",
          "type": "string"
        },
        "severity": {
          "enum": [
            "blocking",
            "suggestion",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "explanation": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 20,
          "title": "Evidence",
          "type": "array"
        },
        "suggestion": {
          "default": "",
          "maxLength": 2000,
          "title": "Suggestion",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "rule_id",
        "conclusion",
        "severity",
        "explanation"
      ],
      "title": "Check",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "file_id": {
          "title": "File Id",
          "type": "string"
        },
        "page_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Number"
        },
        "paragraph_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph Id"
        },
        "quote": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "file_id",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/Check"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Checks",
      "type": "array"
    }
  },
  "required": [
    "checks"
  ],
  "title": "AgentResult",
  "type": "object"
}
