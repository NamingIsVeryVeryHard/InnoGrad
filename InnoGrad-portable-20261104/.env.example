# Copy to .env. Use COOKIE_SECURE=1 behind HTTPS; 0 only for local HTTP.
AI_MODE=chat
AI_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1
AI_MODEL=ecnu-max
AI_API_KEY=
# Begin with manual review; enable agent only after site acceptance.
REVIEW_WORKFLOW=manual
COOKIE_SECURE=0
AI_MAX_ATTEMPTS=3
AI_RETRY_SECONDS=10
INNOAGENT_TIMEOUT_SECONDS=600
INNOAGENT_QUEUE_TIMEOUT_SECONDS=600
INNOAGENT_SKILL=material-review
