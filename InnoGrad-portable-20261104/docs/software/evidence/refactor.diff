+def _matching_quotes(needle, source, normalized):
+    for block_index, block in source:
+        if block_index not in normalized:
+            normalized[block_index] = _without_whitespace(block["text"])
+        text, offsets = normalized[block_index]
+        start = text.find(needle)
+        while start >= 0:
+            candidate = {key: block[key] for key in ("file_id", "page_number", "paragraph_id")}
+            candidate["quote"] = block["text"][offsets[start]:offsets[start + len(needle) - 1] + 1]
+            yield candidate
+            start = text.find(needle, start + 1)
+
+
+def _unique_candidate(supplied, source, normalized):
+    needle, _ = _without_whitespace(supplied["quote"])
+    if not needle:
+        return None
+    candidates = {(*_location(item), item["quote"]): item
+                  for item in _matching_quotes(needle, source, normalized)}
+    preferred = [item for item in candidates.values() if _location(item) == _location(supplied)]
+    matches = preferred or list(candidates.values())
+    return matches[0] if len(matches) == 1 else None
+
