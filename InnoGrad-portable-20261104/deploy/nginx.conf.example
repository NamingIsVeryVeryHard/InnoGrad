# Replace server_name and certificate paths with your actual domain/certificate.
server {
    listen 443 ssl;
    server_name innograd.example.edu;
    ssl_certificate /etc/ssl/innograd/fullchain.pem;
    ssl_certificate_key /etc/ssl/innograd/privkey.pem;
    client_max_body_size 51m;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 240s;
    }
}
