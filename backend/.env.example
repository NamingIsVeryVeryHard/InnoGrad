# Copy to backend/.env. Rules mode does not send any data to a model service.
AI_MODE=rules
# For a school/self-hosted Chat Completions-compatible server:
# AI_MODE=chat
# AI_BASE_URL=https://your-school-model.example/v1
# AI_MODEL=your-model-name
# AI_API_KEY=configure-locally-only
# For a pre-existing agent accepting the documented /review contract:
# AI_MODE=agent
# AI_BASE_URL=https://your-school-agent.example
# Only if the approved internal endpoint requires HTTP:
# AI_ALLOW_INTERNAL_HTTP=1
# DATABASE_URL=postgresql+psycopg://user:password@localhost/graduate
# FILE_ROOT=runtime/files
# COOKIE_SECURE=1

# Agent-first workflow: complete Agent report before institutional confirmation.
# REVIEW_WORKFLOW=agent

# Additive PDF → OCR → material organization → fixed rules → bundle endpoint.
# By default the pipeline reuses AI_BASE_URL / AI_MODEL / AI_API_KEY above;
# these separate names are optional when the material pipeline needs another model.
# MATERIAL_MODEL_BASE_URL=https://your-school-model.example/v1
# MATERIAL_MODEL_NAME=your-material-model
# MATERIAL_MODEL_API_KEY=configure-locally-only
# MATERIAL_PDFTOPPM_BIN=pdftoppm
# MATERIAL_TESSERACT_BIN=tesseract
# MATERIAL_OCR_LANG=chi_sim+eng
# MATERIAL_OCR_TIMEOUT_SECONDS=180

# Teacher paper queries default to the school's dedicated Pi service.
# Configure the backend's actual trusted Pi URL and absolute shared grant directory.
TEACHER_AGENT_MODE=innoagent
# TEACHER_AGENT_BASE_URL=http://127.0.0.1:3108
# TEACHER_AGENT_TIMEOUT_SECONDS=120
# TEACHER_AGENT_GRANT_DIR=/var/run/innograd/teacher-query-grants
# Set the grant directory on BOTH services. Use a private directory (0700)
# owned by their shared service UID, outside all Pi workspaces. In containers,
# mount the same backing directory read-write on the backend and read-only on Pi.
# The filename is the exact Pi session filename, including .jsonl.
#
# On the dedicated Pi service, pin defaultProvider/defaultModel to the school
# deployment and provision only that provider's credentials. In config/config.json
# set memory.l1Enabled, memory.l2Enabled and memory.l3Enabled to false.
# In Pi's config/settings.json set "defaultTools": ["query_papers"] and in
# config/config.json disable plugins.codemode, webAccess, todo and computerUse.
# Install backend/skills/teacher-query-planner in its skills directory and copy
# extensions/teacher-query-planner.ts into its config/extensions directory. Restart Pi.
# With the local InnoAgent checkout, run from the InnoGrad project root:
# node ../inno-agent-audit-20261015/apps/inno-agent/dist/server.js --home "$TEACHER_PI_HOME" --config-dir "$TEACHER_PI_HOME/config" --skills-dir "$TEACHER_PI_HOME/skills" --data-dir "$TEACHER_PI_HOME/data" --workspace "$TEACHER_PI_HOME/workspace" --port 3108
# TEACHER_PI_HOME above is the absolute home of the dedicated teacher worker.
# Set this fixed callback URL in Pi's environment. For separate hosts or
# containers, use the backend address reachable from Pi over a trusted TLS link.
# TEACHER_AGENT_CALLBACK_URL=http://127.0.0.1:8000/api/v1/teacher-agent/tools/query-papers
#
# The extension POSTs {"spec": {...}} or {"patch": {...}} with a per-turn
# Authorization bearer header. The extension returns query_run_id, integer metrics
# and the scoped breakdown, items and portrait to Pi. Keep Authorization headers out of logs.
# The Pi turn has a 120-second timeout. Once its session is ready, the backend
# issues one grant for up to five tool calls within 60 seconds of issuance. It
# unlinks the grant before deleting the isolated Pi session and its workspace.
# Explicit legacy modes are TEACHER_AGENT_MODE=rules and TEACHER_AGENT_MODE=chat.
