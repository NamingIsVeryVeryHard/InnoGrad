# Copy to backend/.env. Rules mode does not send any data to a model service.
AI_MODE=rules
# For a school/self-hosted Chat Completions-compatible server:
# AI_MODE=chat
# AI_BASE_URL=https://your-school-model.example/v1
# AI_MODEL=your-model-name
# AI_API_KEY=configure-locally-only
# For a pre-existing agent accepting the documented /review contract:
# AI_MODE=agent
# AI_BASE_URL=https://your-school-agent.example
# Only if the approved internal endpoint requires HTTP:
# AI_ALLOW_INTERNAL_HTTP=1
# DATABASE_URL=postgresql+psycopg://user:password@localhost/graduate
# FILE_ROOT=runtime/files
# COOKIE_SECURE=1

# Agent-first workflow: complete Agent report before institutional confirmation.
# REVIEW_WORKFLOW=agent
