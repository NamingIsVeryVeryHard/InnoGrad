# Server-side only. Copy to .env; never commit credentials or student material.
PORTRAIT_API_URL=https://chat.ecnu.edu.cn/open/api/v1/chat/completions
PORTRAIT_API_MODEL=ecnu-plus
PORTRAIT_API_KEY=
PORTRAIT_API_TIMEOUT_MS=240000
# Optional quota-only fallback; all three fields are required when enabled.
# PORTRAIT_FALLBACK_GROK_URL=http://127.0.0.1:8318/v1/chat/completions
# PORTRAIT_FALLBACK_GROK_MODEL=grok-4.6
# PORTRAIT_FALLBACK_GROK_KEY=
# PORTRAIT_FALLBACK_GROK_EFFORT=low
# PORTRAIT_FALLBACK_GEMINI_URL=http://127.0.0.1:8318/v1/chat/completions
# PORTRAIT_FALLBACK_GEMINI_MODEL=gemini-3-flash
# PORTRAIT_FALLBACK_GEMINI_KEY=
# PORTRAIT_FALLBACK_GEMINI_EFFORT=low
# Explicit installed InnoAgent instance; no implicit external calls.
INNOAGENT_URL=http://127.0.0.1:3147
INNOAGENT_TIMEOUT_MS=240000
PORTRAIT_JOB_TIMEOUT_MS=300000

# For services started outside the project root, explicitly set an absolute .env path.
# PORTRAIT_ENV_FILE=/absolute/project/.env
INNOAGENT_MODEL_AUDIT_URL=http://127.0.0.1:3148
